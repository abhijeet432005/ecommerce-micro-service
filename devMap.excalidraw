      ],
      "updated": 1786709933770,
      "link": null,
      "locked": false,
      "text": "Clearing the cookie only removes the token from the browser. It does not\ninvalidate the JWT itself.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Clearing the cookie only removes the token from the browser. It does not invalidate the JWT itself.",
