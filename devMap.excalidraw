        }
      ],
      "updated": 1786710089114,
      "link": null,
      "locked": false,
      "text": "JWT Blacklist is a server-side list of revoked tokens. When a user logs out,\ntheir JWT is added to the blacklist so that the server rejects that token\neven if the JWT has not expired yet.",
      "fontSize": 22.29738123301531,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JWT Blacklist is a server-side list of revoked tokens. When a user logs out, their JWT is added to the blacklist so that the server rejects that token even if the JWT has not expired yet.",
      "autoResize": false,
      "lineHeight": 1.25
    },
