      "updated": 1786963192620,
      "link": null,
      "locked": false,
      "text": "- POST /orders - create order from current cart\n- GET /orders/:id - get order by id\n- GET /orders/me - paginated list of the customer's orders\n- GET /orders/seller (Seller) - seller's orders\n- POST /orders/:id/cancel - buyer initiated cancel while pending/paid rules apply; \n                            may trigger refund path.\n- POST /orders/:id/address - attach/update delivery address prior to payment capture",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- POST /orders - create order from current cart\n- GET /orders/:id - get order by id\n- GET /orders/me - paginated list of the customer's orders\n- GET /orders/seller (Seller) - seller's orders\n- POST /orders/:id/cancel - buyer initiated cancel while pending/paid rules apply; \n                            may trigger refund path.\n- POST /orders/:id/address - attach/update delivery address prior to payment capture",
      "autoResize": true,
      "lineHeight": 1.25
    },
